# Existing Google / business configuration
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
CALENDAR_ID=your-calendar-id
SHEET_ID=your-spreadsheet-id
SHOP_TZ=Asia/Calcutta

# Gemini is used directly by the Phase 1 backend and configured separately in Vapi
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Phase 2 Vapi server webhook; use a public HTTPS URL for Vapi
VAPI_SERVER_URL=https://your-public-host/vapi/webhook
VAPI_WEBHOOK_TOKEN=replace-with-a-long-random-token
VAPI_CREDENTIAL_ID=your-vapi-bearer-credential-id
